# ==============================================================================
# Lok-Setu Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend root and populate with your credentials.
# NEVER commit the active '.env' file or expose any secrets to frontend code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port on which the Express server listens (default: 8000)
PORT=8000

# Application environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS Origin for the client frontend
# In local development: http://localhost:5173 (Vite standard)
# In production: https://lok-setu.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Required)
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB Database Name (default: lokSetu)
DB_NAME=lokSetu

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (JWT)
# ------------------------------------------------------------------------------
# Strong random secrets for signing JSON Web Tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_characters_long
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_characters_long
REFRESH_TOKEN_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. REDIS & BACKGROUND QUEUES (BullMQ & Rate Limiter)
# ------------------------------------------------------------------------------
# Optional full Redis connection string (takes precedence if provided)
# e.g., redis://default:<password>@<host>:<port>
REDIS_URL=

# Individual Redis connection settings (used if REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key for OTP verification & citizen notification emails
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Verified Sender Email (use your registered domain or Resend sandbox)
RESEND_FROM_EMAIL=Lok Setu <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (AWS S3)
# ------------------------------------------------------------------------------
# AWS S3 bucket credentials for official gazettes, citizen notices, and audio WAVs
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=lok-setu-storage

# ------------------------------------------------------------------------------
# 7. GOOGLE GEMINI AI CONFIGURATION (@google/genai)
# ------------------------------------------------------------------------------
# Google AI Studio API Key for Gemini 2.5 / 1.5 models & embeddings
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key

# Primary LLM Model for grounded document summarization & civic chat
# Recommended: gemini-2.5-flash (fast, grounded, multilingual)
GEMINI_MODEL=gemini-2.5-flash

# Model for generating dense vector embeddings for RAG hybrid search
# Recommended: text-embedding-004
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Voice model for regional language voice explainers (WAV synthesis)
GEMINI_TTS_MODEL=gemini-2.5-flash

# Request timeout in milliseconds (default: 30000ms = 30 seconds)
GEMINI_TIMEOUT_MS=30000

# Maximum retry attempts for transient API errors
GEMINI_MAX_RETRIES=3
